Map visualization
--------------
install.packages("maps")
library(maps)
map(database = "world")

df <- data.frame(
  city = c("New York", "Los Angeles", "Chicago", "Houston", "Phoenix"),
  lat = c(40.7128, 34.0522, 41.8781, 29.7604, 33.4484),
  lng = c(-74.0060, -118.2437, -87.6298, -95.3698, -112.0740)
)

points(x = df$lng, y = df$lat, col = "Red")


